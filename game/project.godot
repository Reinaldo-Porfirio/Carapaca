; Carcaça — Circuito Fornalha (Godot 4)
config_version=5

[application]

config/name="Carcaça"
config/description="Combate de arena entre carcaças blindadas montadas peça por peça."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.047, 0.051, 1)
boot_splash/show_image=false
config/windows_native_icon=""

[autoload]

D="*res://scripts/data.gd"
Sfx="*res://scripts/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.043, 0.047, 0.051, 1)
textures/canvas_textures/default_texture_filter=1
